# Main configuration parameters
export IMAGE_DATA_ROOT="/home/NMW_web_upload"
export DATA_PROCESSING_ROOT="/home/NMW_web_upload"
export VAST_REFERENCE_COPY="$DATA_PROCESSING_ROOT"/vast

export URL_OF_DATA_PROCESSING_ROOT="http://scan.sai.msu.ru/unmw/uploads"

export REFERENCE_IMAGES=/dataX/kirx/NMW_reference_images_2012

# Long-term image archive for the archival forced photometry queue
# (archive_forced_photometry.py). The archive images carry the wcs_fd_
# prefix before the field name (wcs_fd_<FIELD>_...fits) and cover the same
# fields as the reference images. Today all images sit directly in this
# directory; subdirectories (for example one per month) are also searched.
# A subdirectory named "bad" (rejected frames) is always ignored.
# Archival forced photometry is disabled unless this is set.
#export IMAGE_ARCHIVE_DIR="/mnt/nmwttu1/NMW-TexasTech_archive"

# Optional URL prefix at which IMAGE_ARCHIVE_DIR is served by the web
# server. When set, archival photometry results pages link the original
# FITS files; when unset, the result rows simply have no FITS link (the
# large archive images are never copied into the results directory).
#export IMAGE_ARCHIVE_URL="http://example.com/NMW-TexasTech_archive"

# Archival photometry queue protection (defaults shown):
# maximum queued+running jobs, maximum queued+running jobs per client IP,
# and how many jobs may run at the same time (worker slots).
#export ARCHIVE_PHOT_MAX_QUEUE=10
#export ARCHIVE_PHOT_MAX_QUEUE_PER_IP=5
#export ARCHIVE_PHOT_MAX_RUNNING=2

# 1-min load average above which the archival photometry worker delays
# starting the next job (bounded wait, then it proceeds anyway). Falls back
# to MAX_SYSTEM_LOAD; no load gating when neither variable is set.
#export ARCHIVE_PHOT_MAX_SYSTEM_LOAD=14.0

# Thumbnail (in-page) width/height in pixels for the coord_search.py CGI tool.
# The click-through hi-res image is fixed at 4x this value.
#export COORD_SEARCH_THUMBNAIL_PIXELS=256

# Half-width in source-image pixels of the zoom-in thumbnail produced by
# coord_search.py (passed to util/make_finding_chart --width). The output
# covers a 2N x 2N pixel square centred on the target.
#export COORD_SEARCH_ZOOMIN_PIXELS=200

# Number of parallel worker threads coord_search.py uses to render PNGs.
# Each worker takes one FITS file and produces all of its plots
# sequentially, so workers do not collide on the shared output filename.
# Default 16; lower it on small servers if memory or CPU is a concern.
#export COORD_SEARCH_PARALLEL_WORKERS=16

# Note that $HOME is typically not defined in CGI environment, so use absolute paths!


# Specify plate-solve service
# as local (requires locally installed astromety.net code and indexes)
#ASTROMETRYNET_LOCAL_OR_REMOTE="local"
# or remote
#export ASTROMETRYNET_LOCAL_OR_REMOTE="remote"
#export FORCE_PLATE_SOLVE_SERVER="scan.sai.msu.ru"

# Wait to start processing until system parameters are below these values
#export MAX_IOWAIT_PERCENT=3.0                                                                                                                                
#export MAX_CPU_TEMP_C=65.0
#export MAX_SYSTEM_LOAD=3.0

# Raise warning in the processing log on low disk space
# 'util/transients/transient_factory_test31.sh' script will look for that variable
# Default soft limit is 100 GB = 100 * 1024 * 1024 KB
#export WARN_ON_LOW_DISK_SPACE_SOFTLIMIT_KB=104857600

# Hard limit: reject uploads and abort processing below this threshold
# Default hard limit is 5 GB = 5 * 1024 * 1024 KB
#export WARN_ON_LOW_DISK_SPACE_HARDLIMIT_KB=5242880

# set this variable to indicate this file has been sourced
# (can be checked in order not to source it twice)
export UNMW_LOCAL_CONFIG_SOURCED=yes


# AAVSO observer code used in the AAVSO-format lightcurve files produced by
# the source monitoring feature (uploads/monitoring/<source>/lightcurve_aavso.txt).
# When unset, the code is taken from AAVSO_previously_used_header.txt in the
# VaST reference copy, falling back to the XXX placeholder.
#export AAVSO_OBSCODE="SKA"
