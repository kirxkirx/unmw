# These are special instructions for Apache web server.
#
# IMPORTANT: none of the rules below take effect unless the enclosing vhost
# grants this directory the authority to override. With the Apache default
# (AllowOverride None) every Require here is SILENTLY IGNORED - the file is
# not read at all - so a script the rules appear to protect is still served
# and, under SetHandler cgi-script, executed. A working vhost block is:
#
#   <Directory "/var/www/example.net/cgi-bin">
#       AllowOverride AuthConfig Options=ExecCGI
#       Options ExecCGI FollowSymLinks
#       SetHandler cgi-script
#       Require all granted
#   </Directory>
#
# "Limit" is what permits the Require directives below; "Options=ExecCGI" is
# what permits the Options line further down. Granting more than that is not
# needed here.
#
# Do NOT put <Directory>, <DirectoryMatch> or AllowOverride in this file:
# they are legal only in server/vhost context, and Apache answers 500 for
# every request in this tree if it finds them here. Restricting CGI
# execution in subdirectories belongs in the vhost, not here.
#
# Because all of the above depends on server configuration this project does
# not control, the rules here are only the second line of defence. Every
# script that is not a CGI entry point ALSO refuses to run as a CGI on its
# own - see the GATEWAY_INTERFACE guard at the top of those files. That
# guard is the authoritative protection; this file is belt and braces.

# Allow CGI execution in the current directory
Options +ExecCGI

# Tell Apache it cannot run the shell scripts directly
<FilesMatch "\.sh$">
    Require all denied
</FilesMatch>

# Deny access to filter_report.py specifically
<Files "filter_report.py">
    Require all denied
</Files>

# The archival-photometry queue worker and the importable helper modules
# are not CGI entry points - forbid direct web access to them
<FilesMatch "^(archive_phot_worker\.py|nmw_coord_lib\.py|nmw_forced_phot_lib\.py|nmw_archive_phot_lib\.py|monitoring_update\.py|nmw_monitoring_lib\.py)$">
    Require all denied
</FilesMatch>

# Not CGI entry points either, deny direct web access:
#   test_python.py - the pytest suite; running it as the web user would spawn
#                    shells and write files
#   upload.py2     - legacy Python-2 upload handler with much weaker validation
#                    than upload.py3; kept for exceptional circumstances only,
#                    must never be reachable over the web
<FilesMatch "^(test_python\.py|upload\.py2)$">
    Require all denied
</FilesMatch>

